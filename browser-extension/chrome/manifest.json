{
  "manifest_version": 3,
  "name": "TDM 下载助手",
  "description": "将浏览器文件下载交给 TDM，确认后开始下载。",
  "version": "0.1.3",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "storage",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TDM 下载助手"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "打开 TDM 下载助手"
    }
  }
}
