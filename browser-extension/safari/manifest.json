{
  "manifest_version": 3,
  "name": "TDM 下载助手",
  "version": "0.1.2",
  "description": "点击文件链接时唤起 TDM 确认下载。",
  "permissions": [
    "nativeMessaging",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TDM 下载助手（Shift + Command + D）"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+D",
        "mac": "Command+Shift+D"
      },
      "description": "打开 TDM 下载助手"
    }
  }
}
