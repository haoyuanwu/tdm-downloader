{
  "build": {
    "runner": "../scripts/macos-dev-runner.sh",
    "beforeBuildCommand": "bash scripts/build-browser-extensions.sh && npm run build"
  },
  "bundle": {
    "macOS": {
      "signingIdentity": "-",
      "infoPlist": "Info.plist"
    },
    "resources": {
      "../release/safari/TDM Safari Connector.app/": "safari/TDM Safari Connector.app/",
      "../browser-extension/chrome/": "browser/chrome/",
      "../release/browser-native/tdm-browser-bridge": "browser/tdm-browser-bridge",
      "../browser-extension/native/version.json": "browser/native-version.json"
    }
  }
}
