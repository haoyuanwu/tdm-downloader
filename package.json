{
  "name": "tdm-downloader",
  "private": true,
  "version": "0.2.10",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "package": "tauri build && node scripts/rename-artifacts.mjs",
    "package:prefix": "tauri build && node scripts/rename-artifacts.mjs --prefix=TDM-Downloader",
    "release:macos": "bash scripts/release-macos.sh",
    "package:macos": "bash scripts/build-macos.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^7.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
